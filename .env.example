# Four distinct A100 80GB GPUs allocated to THIS single-size experiment.
HINTSD_GPUS=0,1,2,3
# CPU-only WebShop runtime; default is this checkout's .env-webshop/bin/python.
# HINTSD_ENV_PYTHON=/path/on/your/server/this-checkout/.env-webshop/bin/python
REPORT_TO=none
TOKENIZERS_PARALLELISM=false
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
OMP_NUM_THREADS=1
_JAVA_OPTIONS="-XX:+UseSerialGC -Xss512k -Xmx1g"
